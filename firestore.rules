rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSessionId', 'completedClasses']))
      );
      allow delete: if request.auth != null && isAdmin();
    }

    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /courseContent/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /batches/{batchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /partnershipLeads/{id} {
      allow read, update, delete: if request.auth != null && isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'whatsapp', 'amount', 'marketplace', 'category', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0;
    }

    match /feedback/{id} {
      allow read: if resource.data.status == 'approved' || (request.auth != null && isAdmin());
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.type in ['course', 'service']
        && request.resource.data.keys().hasOnly(['type', 'name', 'rating', 'quote', 'imageUrl', 'status', 'createdAt']);
      allow update, delete: if request.auth != null && isAdmin();
    }

    function isAdmin() {
      return request.auth.token.email in ['ampplifyacademy@gmail.com'];
    }
  }
}
