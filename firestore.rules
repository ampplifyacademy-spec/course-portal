rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // A new account may only describe itself; it can never approve itself or
      // set payment, batch or access fields - those belong to the admin.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'email', 'whatsapp', 'invoiceUrl', 'status', 'createdAt',
             'serviceDocuments', 'selectedServices', 'serviceTotal', 'serviceCurrency', 'preferredCallDate',
             'preferredCallTime', 'productType', 'toolName', 'toolPrice', 'toolCurrency', 'toolLink']);
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSessionId', 'completedClasses']))
      );
      allow delete: if request.auth != null && isAdmin();
    }

    match /courses/{courseId} {
      allow read: if request.auth != null && (isAdmin() || isApprovedUser());
      allow write: if request.auth != null && isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /courseContent/{docId} {
      allow read: if request.auth != null && (isAdmin() || isApprovedUser());
      allow write: if request.auth != null && isAdmin();
    }

    match /batches/{batchId} {
      allow read: if request.auth != null && (isAdmin() || isApprovedUser());
      allow write: if request.auth != null && isAdmin();
    }

    match /partnershipLeads/{id} {
      allow read, update, delete: if request.auth != null && isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'whatsapp', 'amount', 'marketplace', 'category', 'planType', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0;
    }

    match /feedback/{id} {
      allow read: if resource.data.status == 'approved' || (request.auth != null && isAdmin());
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.type in ['course', 'service']
        && request.resource.data.keys().hasOnly(['type', 'name', 'rating', 'quote', 'imageUrl', 'status', 'createdAt']);
      allow update, delete: if request.auth != null && isAdmin();
    }

    function isAdmin() {
      // The email must also be verified, so an unverified account that merely
      // claims the admin address is not treated as the admin.
      return request.auth.token.email in ['ampplifyacademy@gmail.com']
        && request.auth.token.email_verified == true;
    }

    // Course material is for accounts the admin has approved, not for anyone
    // who has merely signed up.
    function isApprovedUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
  }
}
